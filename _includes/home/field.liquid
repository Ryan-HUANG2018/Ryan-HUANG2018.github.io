{% comment %} "In the field" preview on the homepage: the first three photos, with a link to /field/ for the rest. Hidden while _data/field.yml is empty. {% endcomment %}
{% assign photos = site.data.field %}
{% if photos and photos.size > 0 %}
  <section id="field" class="rh-section">
    <div class="rh-section-head">
      {% include section_title.liquid title='In the field' sub='Talks, workshops and the people I work with.' %}
      {% if photos.size > 3 %}
        <a class="rh-mono rh-section-link" href="{{ '/field/' | relative_url }}">all {{ photos.size }} photos →</a>
      {% endif %}
    </div>
    {% include field_grid.liquid limit=3 %}
  </section>
{% endif %}
