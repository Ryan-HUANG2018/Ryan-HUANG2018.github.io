{% comment %} "In the field": approved conference and group photos from _data/field.yml. Hidden while the list is empty. {% endcomment %}
{% assign photos = site.data.field %}
{% if photos and photos.size > 0 %}
  <section id="field" class="rh-section">
    <div class="rh-section-head">
      {% include section_title.liquid title='In the field' sub='Talks, workshops and the people I work with.' %}
    </div>
    <div class="rh-field rh-field-n{{ photos.size }}">
      {% for p in photos %}
        <figure class="rh-field-item rh-field-{{ forloop.index }}">
          <img src="{{ p.src | relative_url }}" alt="{{ p.alt | default: p.title | escape }}" loading="lazy">
          <figcaption class="rh-glass">
            <span class="rh-field-t">{{ p.title }}</span>
            <span class="rh-field-k rh-mono">
              {%- if p.place %}{{ p.place | upcase }} · {% endif -%}
              {{- p.year -}}
            </span>
          </figcaption>
        </figure>
      {% endfor %}
    </div>
  </section>
{% endif %}
