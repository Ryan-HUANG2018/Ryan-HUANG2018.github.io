{% comment %} "Early design work": CATIA models from the master's projects. Data: _data/design.yml. Hidden while the list is empty. {% endcomment %}
{% assign designs = site.data.design %}
{% if designs and designs.size > 0 %}
  <div class="rh-design-block">
    <div class="rh-section-head">
      {% include section_title.liquid title='Early design work' sub="CATIA models I built for CFD during my master's at NUAA: a fuel diffuser for the AG600 amphibious aircraft and drag parachutes." %}
    </div>
    <div class="rh-design">
      {% for d in designs %}
        <figure class="rh-field-item rh-design-item">
          <img
            src="{{ d.src | relative_url }}"
            alt="{{ d.alt | default: d.title | escape }}"
            loading="lazy"
            {% if d.focus %}
              style="object-position: {{ d.focus }}"
            {% endif %}
          >
          <figcaption>
            <span class="rh-field-t">{{ d.title }}</span>
            <span class="rh-field-k rh-mono">
              {%- if d.tool %}{{ d.tool | upcase }} · {% endif -%}
              {{- d.year -}}
            </span>
          </figcaption>
        </figure>
      {% endfor %}
    </div>
  </div>
{% endif %}
