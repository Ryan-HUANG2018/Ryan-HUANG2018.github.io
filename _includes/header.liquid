<header>
  {% assign rh_has_field = false %}
  {% if site.data.field and site.data.field.size > 0 %}{% assign rh_has_field = true %}{% endif %}
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-expand-lg rh-nav {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="rh-container">
      <a class="navbar-brand rh-brand" href="{{ '/' | relative_url }}">
        <img class="rh-brand-avatar" src="{{ 'assets/img/avatar.jpg' | relative_url }}" alt="" width="34" height="34">
        <span>{{ site.first_name | slice: 0 | upcase }}.{{ site.last_name | upcase }}</span>
        <span class="rh-brand-sub">// fluid dynamics</span>
      </a>
      {% if site.enable_darkmode %}
        <button
          class="rh-theme-toggle rh-theme-toggle-mobile d-lg-none ml-auto"
          type="button"
          title="Switch light / dark theme"
          aria-label="Switch light / dark theme"
        >
          <i class="ti ti-sun rh-theme-icon-sun" aria-hidden="true"></i>
          <i class="ti ti-moon rh-theme-icon-moon" aria-hidden="true"></i>
        </button>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed {% unless site.enable_darkmode %}ml-auto{% endunless %}"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          <li class="nav-item">
            <a class="nav-link" href="{{ '/#sims' | relative_url }}">Simulations</a>
          </li>
          <li class="nav-item {% if page.url contains '/publications/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/#pubs' | relative_url }}">Publications</a>
          </li>
          {% if rh_has_field %}
            <li class="nav-item {% if page.url contains '/field/' %}active{% endif %}">
              <a class="nav-link" href="{{ '/field/' | relative_url }}">In the field</a>
            </li>
          {% endif %}
          <li class="nav-item {% if page.url contains '/news/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/#news' | relative_url }}">News</a>
          </li>
          <li class="nav-item {% if page.url contains '/cv/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/cv/' | relative_url }}">CV</a>
          </li>
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="ti ti-search"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <li class="nav-item d-none d-lg-block">
              <button class="rh-theme-toggle" type="button" title="Switch light / dark theme" aria-label="Switch light / dark theme">
                <i class="ti ti-sun rh-theme-icon-sun" aria-hidden="true"></i>
                <i class="ti ti-moon rh-theme-icon-moon" aria-hidden="true"></i>
              </button>
            </li>
          {% endif %}
          <li class="nav-item rh-nav-cta">
            <a class="rh-btn rh-btn-solid" href="{{ '/#connect' | relative_url }}">Contact</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
