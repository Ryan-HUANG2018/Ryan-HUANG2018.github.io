{% comment %}
  Photo grid for "In the field". Data: _data/field.yml.
  Params: limit (optional) shows only the first N photos; their layout follows the count shown.
{% endcomment %}
{% assign photos = site.data.field %}
{% if include.limit %}{% assign photos = site.data.field | slice: 0, include.limit %}{% endif %}
<div class="rh-field rh-field-n{{ photos.size }}{% if photos.size > 3 %} rh-field-many{% endif %}">
  {% for p in photos %}
    <figure class="rh-field-item rh-field-{{ forloop.index }}{% if p.size %} is-{{ p.size }}{% endif %}">
      <img
        src="{{ p.src | relative_url }}"
        alt="{{ p.alt | default: p.title | escape }}"
        loading="lazy"
        {% if p.focus %}
          style="object-position: {{ p.focus }}"
        {% endif %}
      >
      <figcaption class="rh-glass">
        <span class="rh-field-t">{{ p.title }}</span>
        <span class="rh-field-k rh-mono">
          {%- if p.place %}{{ p.place | upcase }} · {% endif -%}
          {{- p.year -}}
        </span>
      </figcaption>
    </figure>
  {% endfor %}
</div>
